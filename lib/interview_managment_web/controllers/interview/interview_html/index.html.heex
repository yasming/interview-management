<Layouts.app flash={@flash}>
  <.header>
    Interviews
    <:actions>
      <button type="button" class="btn btn-primary" onclick="interview_modal.showModal()">
        Add
      </button>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="stats bg-primary text-primary-content shadow w-full">
      <div class="stat">
        <div class="stat-figure text-primary-content/70">
          <.icon name="hero-paper-airplane" class="size-8" />
        </div>
        <div class="stat-title text-primary-content/70">Applied today</div>
        <div class="stat-value">{@applied_today}</div>
        <div class="stat-desc text-primary-content/70">
          position{if @applied_today != 1, do: "s"} on {Date.utc_today()}
        </div>
      </div>
    </div>

    <div class="stats bg-primary text-primary-content shadow w-full">
      <div class="stat">
        <div class="stat-figure text-primary-content/70">
          <.icon name="hero-briefcase" class="size-8" />
        </div>
        <div class="stat-title text-primary-content/70">Total applied</div>
        <div class="stat-value">{@total_applied}</div>
        <div class="stat-desc text-primary-content/70">
          position{if @total_applied != 1, do: "s"} applied to
        </div>
      </div>
    </div>

    <div class="stats bg-primary text-primary-content shadow w-full">
      <div class="stat">
        <div class="stat-figure text-primary-content/70">
          <.icon name="hero-check-circle" class="size-8" />
        </div>
        <div class="stat-title text-primary-content/70">Total interviews got</div>
        <div class="stat-value">{@got_interview}</div>
        <div class="stat-desc text-primary-content/70">
          interview{if @got_interview != 1, do: "s"} secured
        </div>
      </div>
    </div>

    <div class="stats bg-primary text-primary-content shadow w-full">
      <div class="stat">
        <div class="stat-figure text-primary-content/70">
          <.icon name="hero-x-circle" class="size-8" />
        </div>
        <div class="stat-title text-primary-content/70">Denied without interview</div>
        <div class="stat-value">{@denied_without_interview}</div>
        <div class="stat-desc text-primary-content/70">
          contacted, no interview
        </div>
      </div>
    </div>
  </div>

  <.form for={%{}} action={~p"/"} method="get" class="flex items-center gap-2 mt-4">
    <input
      type="text"
      name="search"
      value={@search}
      placeholder="Search by company name"
      class="input input-bordered w-full max-w-xs"
    />
    <button type="submit" class="btn btn-primary">Search</button>
    <a :if={@search not in [nil, ""]} href={~p"/"} class="btn btn-ghost">Clear</a>
  </.form>

  <.table id="interviews" rows={@interviews}>
    <:col :let={interview} label="Date applied">{interview.date_applied}</:col>
    <:col :let={interview} label="Date contacted">
      <.form
        for={%{}}
        action={~p"/interviews/#{interview.id}/contacted"}
        method="patch"
        class="flex items-center gap-2"
      >
        <input
          type="date"
          name="interview[date_contacted]"
          value={interview.date_contacted}
          class="input input-sm"
        />
        <button type="submit" class="btn btn-sm btn-primary">Save</button>
      </.form>
    </:col>
    <:col :let={interview} label="Description">{interview.description}</:col>
    <:col :let={interview} label="Link">
      <a
        :if={interview.link not in [nil, ""]}
        href={interview.link}
        class="link"
        target="_blank"
        rel="noopener noreferrer"
      >
        link
      </a>
    </:col>
    <:col :let={interview} label="Company name">{interview.company_name}</:col>
    <:col :let={interview} label="Got interview">
      <div class="flex items-center gap-1">
        <.form
          for={%{}}
          action={~p"/interviews/#{interview.id}/got_interview"}
          method="patch"
        >
          <input type="hidden" name="got_interview" value="true" />
          <button
            type="submit"
            class="btn btn-ghost btn-sm btn-circle"
            title="Got interview"
          >
            <.icon
              :if={interview.got_interview == true}
              name="hero-check-circle-solid"
              class="size-6 text-success"
            />
            <.icon
              :if={interview.got_interview != true}
              name="hero-check-circle"
              class="size-6 text-base-content/30"
            />
          </button>
        </.form>

        <.form
          for={%{}}
          action={~p"/interviews/#{interview.id}/got_interview"}
          method="patch"
        >
          <input type="hidden" name="got_interview" value="false" />
          <button
            type="submit"
            class="btn btn-ghost btn-sm btn-circle"
            title="Didn't get interview"
          >
            <.icon
              :if={interview.got_interview == false}
              name="hero-x-circle-solid"
              class="size-6 text-error"
            />
            <.icon
              :if={interview.got_interview != false}
              name="hero-x-circle"
              class="size-6 text-base-content/30"
            />
          </button>
        </.form>
      </div>
    </:col>
  </.table>

  <.interview_modal form={@form} />

  <script :if={@form.source.action} type="text/javascript">
    interview_modal.showModal();
  </script>
</Layouts.app>
